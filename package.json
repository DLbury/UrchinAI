{
  "name": "urchin-electron",
  "version": "0.4.7",
  "description": "UrchinAI — Electron",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && electron . --no-sandbox\"",
    "build": "vite build",
    "electron": "electron . --no-sandbox",
    "start": "NODE_ENV=production electron . --no-sandbox",
    "dist": "npm run build && npm run build:backend:win && npm run build:backend:linux && electron-builder -mwl --publish never",
    "build:backend:win": "node scripts/build-backend-win.cjs",
    "build:backend:linux": "node scripts/build-backend-linux.cjs",
    "dist:win": "npm run build && npm run build:backend:win && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run build:backend:linux && electron-builder --linux deb --publish never"
  },
  "build": {
    "appId": "com.urchinai.browser",
    "productName": "UrchinAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/ws/**/*",
      "node_modules/bufferutil/**/*",
      "node_modules/utf-8-validate/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/urchinai-backend.exe",
        "to": "backend/urchinai-backend.exe"
      },
      {
        "from": "backend/urchinai-backend",
        "to": "backend/urchinai-backend"
      }
    ],
    "asarUnpack": [
      "node_modules/ws/**/*",
      "node_modules/bufferutil/**/*",
      "node_modules/utf-8-validate/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "shortcutName": "UrchinAI"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Network",
      "maintainer": "UrchinAI",
      "executableName": "urchinai-browser",
      "icon": "build/icons",
      "desktop": {
        "Name": "UrchinAI",
        "Comment": "AI-powered smart desktop browser",
        "Categories": "Network;WebBrowser;"
      }
    },
    "deb": {
      "packageCategory": "Network",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libasound2t64"
      ],
      "afterInstall": "build/linux/postinst.sh"
    }
  },
  "keywords": [
    "ai-browser",
    "ai-agent",
    "browser-automation",
    "electron-browser",
    "llm-browser",
    "web-automation",
    "natural-language-interface",
    "openai",
    "anthropic",
    "deepseek",
    "gemini",
    "chatgpt",
    "claude",
    "browser-agent",
    "desktop-browser"
  ],
  "author": "UrchinAI",
  "license": "MIT",
  "homepage": "https://github.com/urchinai/browser",
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-icon-builder": "^2.0.1",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/uuid": "^10.0.0",
    "ai": "^6.0.152",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^25.8.17",
    "lucide-react": "^0.453.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.2.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  }
}
